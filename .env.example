# TrainWatch · variables de entorno para desarrollo local.
# Copia este fichero en .env (está en .gitignore) y cambia la clave. Lo leen Docker Compose
# (--env-file .env) y el backend con el perfil local (application-local.properties).
# Formato CLAVE=valor, sin comillas ni "export": Spring lo lee como un fichero .properties y las comillas
# acabarían dentro del valor.
TRAINWATCH_DB_HOST=localhost
TRAINWATCH_DB_PORT=5432
TRAINWATCH_DB_NAME=trainwatch
TRAINWATCH_DB_USER=trainwatch
TRAINWATCH_DB_PASSWORD=cambia-esta-clave
# Token del disparo manual de la importación del horario (POST /api/horario/importaciones, cabecera
# X-Trainwatch-Token). Vacío: el endpoint está desactivado.
TRAINWATCH_ADMIN_TOKEN=
