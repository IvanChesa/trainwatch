# Cabeceras de seguridad de la web en Cloudflare Pages (fase 7). Vite copia este fichero tal cual a dist/.
# connect-src: la API y el directo (trainwatch-api) y el mapa de OpenFreeMap (estilo, teselas, sprites y letras, que
# MapLibre pide con fetch). img-src: las teselas de relieve de OpenFreeMap y las imágenes que MapLibre decodifica en blob:.
# worker-src: el worker de MapLibre, que se sirve desde la propia web ('self'; blob: por si MapLibre tiene que envolverlo).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://tiles.openfreemap.org; connect-src 'self' https://trainwatch-api.ivanchesa.com https://tiles.openfreemap.org; worker-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
