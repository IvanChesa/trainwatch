# Cabeceras de seguridad de la web en Cloudflare Pages (fase 7). Vite copia este fichero tal cual a dist/.
# connect-src: la API y el directo (trainwatch-api). La fase 5 tendrá que añadir los mapas (OpenFreeMap).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://trainwatch-api.ivanchesa.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
